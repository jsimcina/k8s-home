---
customization:
  extraKernelArgs:
    - -selinux # Disable SELinux (removes the default selinux=1)
    - audit=0 # Disable kernel audit
    - i915.enable_guc=3 # Meteor Lake CPU & Intel iGPU
    - intel_iommu=on # PCI Passthrough
    - iommu=pt # PCI Passthrough
    - selinux=0 # Disable SELinux
    - sysctl.kernel.kexec_load_disabled=1 # Meteor Lake CPU / iGPU
    - talos.auditd.disabled=1 # Disable Talos auditd (pair with audit=0)
  systemExtensions:
    officialExtensions:
      - siderolabs/drbd # miroir replication (kubernetes/apps/miroir-system)
      - siderolabs/gvisor # Sandboxed containers (kubernetes/apps/kube-system/gvisor)
      - siderolabs/i915 # Intel iGPU
      - siderolabs/intel-ucode # Intel iGPU
      - siderolabs/mei # Intel iGPU
      - siderolabs/nfsrahead # NFS readahead (nfs.conf in cluster.yaml.j2)
